{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "package.json",
      "**/.*",
      "**/node_modules/**",
      "docs/**",
      "tests/**",
      "tools/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
